{
  "hosting": {
    "public": "frontend",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/broadcast",
        "destination": "/broadcast.html"
      },
      {
        "source": "/broadcast/**",
        "destination": "/broadcast.html"
      },
      {
        "source": "/overlay",
        "destination": "/overlay.html"
      },
      {
        "source": "/overlay/**",
        "destination": "/overlay.html"
      },
      {
        "source": "/monitor",
        "destination": "/monitor.html"
      },
      {
        "source": "/monitor/**",
        "destination": "/monitor.html"
      },
      {
        "source": "/session/**",
        "destination": "/index.html"
      },
      {
        "source": "/audience/**",
        "destination": "/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
